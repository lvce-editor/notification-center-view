{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "composite": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["esnext"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmit": true,
    "noImplicitAny": false,
    "noUnusedLocals": true,
    "skipLibCheck": false,
    "strict": true,
    "target": "esnext",
    "types": ["node"]
  },
  "include": ["src"]
}
