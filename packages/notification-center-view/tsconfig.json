{
  "compilerOptions": {
    "composite": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmit": true,
    "strict": true,
    "target": "esnext",
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
